;;; -*- mode: lisp; package: user -*-
;;;
;;; The exchange between xyzzycli.exe and xyzzy.exe (S4 stage 3, R8; design
;;; 10.4).  xyzzycli makes UTF-8 from GetCommandLineW and writes it to the
;;; shared memory ("xyzzy-server v3"); xyzzy reads it as UTF-8.
;;;
;;; The test starts xyzzycli.exe against the xyzzy that runs the test, with a
;;; file whose name is Japanese, and looks at the buffer that is opened.  It
;;; needs no window of the user: the test runs in the session of the CI.
;;;
;;; This file is ASCII: the characters are asked for by their Unicode.

(in-package :user)

(defun xyzzycli-test-name (&rest codes)
  (coerce (mapcar #'unicode-char codes) 'string))

(defvar *xyzzycli-test-log* nil)
(defun xyzzycli-test-hook (arg)
  (push arg *xyzzycli-test-log*)
  nil)
(add-hook '*process-command-line-hook* 'xyzzycli-test-hook)

(defun xyzzycli-test-tasklist ()
  (let* ((tb (create-new-buffer "*xyzzycli-test-ps*"))
         (p (make-process "tasklist /v /fo csv /nh /fi \"imagename eq xyzzy.exe\""
                          :output tb :show :hide)))
    (unwind-protect
        (let ((deadline (+ (get-universal-time) 10)))
          (while (and (eql (process-status p) :run)
                      (< (get-universal-time) deadline))
            (sleep-for 0.1))
          (sleep-for 0.3)
          (save-excursion
            (set-buffer tb)
            (buffer-substring (point-min) (point-max))))
      (delete-buffer tb))))

;; The buffer is looked for by its name (the name part of the file): the test
;; directory has an 8.3 name in the CI ("NETWOR~1"), and the buffer of
;; find-file may have the long name, so get-file-buffer with the path may not
;; find it.
(defun xyzzycli-test-open (path name)
  "Runs xyzzycli.exe with PATH. Returns (buffer-name process-status exit-code output buffers)."
  (let* ((cli (merge-pathnames "xyzzycli.exe" (si:system-root)))
         (tmpbuf (create-new-buffer "*xyzzycli-test*"))
         (proc nil)
         (buffer nil))
    ;; make the server again: the property of the window is set when it is made
    (stop-xyzzy-server)
    (start-xyzzy-server)
    (unwind-protect
        (progn
          (setq proc (make-process (format nil "\"~A\" \"~A\"" cli path)
                                   :output tmpbuf :show :hide))
          (let ((deadline (+ (get-universal-time) 20)))
            (loop
              (setq buffer (find-buffer name))
              (when (or buffer (> (get-universal-time) deadline))
                (return))
              (sleep-for 0.1)))
          (list (and buffer (buffer-name buffer))
                (process-status proc)
                (and (not (eql (process-status proc) :run))
                     (process-exit-code proc))
                (save-excursion
                  (set-buffer tmpbuf)
                  (buffer-substring (point-min) (point-max)))
                (mapcar #'(lambda (b) (list (buffer-name b) (get-buffer-file-name b)))
                        (buffer-list))
                (list (fboundp 'ed::*xyzzycli-helper) *xyzzycli-test-log*)))
      (when (and proc (eql (process-status proc) :run))
        (ignore-errors (signal-process proc)))
      (let ((b (find-buffer name)))
        (when b
          (ignore-errors (delete-buffer b))))
      (ignore-errors (delete-buffer tmpbuf)))))

(deftest xyzzycli-opens-file-with-japanese-name ()
  (let* ((tmp (make-temp-file-name))
         (name (concatenate 'string
                            (xyzzycli-test-name #x65e5 #x672c #x8a9e)
                            "-" (pathname-name tmp) ".txt"))
         (path (merge-pathnames name (directory-namestring tmp))))
    (unwind-protect
        (progn
          (with-open-file (s path :direction :output :if-exists :supersede)
            (format s "x"))
          (if (file-exist-p (merge-pathnames "xyzzycli.exe" (si:system-root)))
              (let ((r (xyzzycli-test-open path name)))
                (or (equal (car r) name) r))
            :no-xyzzycli))
      (ignore-errors (delete-file path))
      (ignore-errors (delete-file tmp))))
  => t)

(deftest xyzzycli-opens-file-with-ascii-name ()
  (let* ((tmp (make-temp-file-name))
         (name (concatenate 'string "xyzzycli-" (pathname-name tmp) ".txt"))
         (path (merge-pathnames name (directory-namestring tmp))))
    (unwind-protect
        (progn
          (with-open-file (s path :direction :output :if-exists :supersede)
            (format s "x"))
          (if (file-exist-p (merge-pathnames "xyzzycli.exe" (si:system-root)))
              (let ((r (xyzzycli-test-open path name)))
                (or (equal (car r) name) r))
            :no-xyzzycli))
      (ignore-errors (delete-file path))
      (ignore-errors (delete-file tmp))))
  => t)
