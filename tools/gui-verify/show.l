;; usage: env TFILE=<path> TENC=<name> TMODE=<name>
(let* ((f (si:getenv "TFILE"))
       (e (si:getenv "TENC"))
       (m (si:getenv "TMODE"))
       (enc (cond ((string= e "sjis") *encoding-sjis*)
                  ((string= e "iso1") *encoding-iso-8859-1*)
                  ((string= e "iso2") *encoding-iso-8859-2*)
                  ((string= e "iso5") *encoding-iso-8859-5*)
                  ((string= e "iso7") *encoding-iso-8859-7*)
                  ((string= e "iso9") *encoding-iso-8859-9*)
                  ((string= e "iso13") *encoding-iso-8859-13*)
                  ((string= e "gb") *encoding-euc-gb*)
                  ((string= e "big5") *encoding-big5*)
                  ((string= e "kr") *encoding-euc-kr*)
                  ((string= e "utf8") *encoding-utf8n*)
                  (t nil))))
  (setq editor::*status-bar-format* "pcu")
  (find-file f enc)
  (goto-char (point-min))
  (cond
   ((string= m "attr")
    ;; text attributes on line 2 and 3, then edit in the middle of a line
    (goto-line 2)
    (set-text-attribute (point) (+ (point) 12) 'a1 :foreground 3 :background 5 :bold t)
    (goto-line 3)
    (set-text-attribute (point) (+ (point) 14) 'a2 :foreground 1 :underline t)
    (goto-line 4)
    (set-text-attribute (point) (+ (point) 8) 'a3 :strike-out t :bold t :underline t)
    (goto-line 1)
    (refresh-screen)
    (goto-line 2)
    (forward-char 3)
    (insert "x")
    (goto-line 3)
    (forward-char 2)
    (insert "yy")
    (goto-line 5)
    (delete-char 1)
    (goto-line 1))
   ((string= m "hscroll")
    (set-buffer-fold-width nil)
    (goto-line 2)
    (scroll-window-horizontally 5)
    (refresh-screen)
    (scroll-window-horizontally 3))
   ((string= m "hscroll2")
    (set-buffer-fold-width nil)
    (goto-line 2)
    (scroll-window-horizontally 1)
    (refresh-screen)
    (scroll-window-horizontally 2))
   ((string= m "fw")
    (goto-line 2))
   ((string= m "fold")
    (set-buffer-fold-width 30)))
  (refresh-screen))
(defun pd () (interactive) (print-dialog))
(define-key *global-keymap* #\F3 'pd)
(defun pdone () (interactive) (kill-xyzzy))
(define-key *global-keymap* #\F12 'pdone)
